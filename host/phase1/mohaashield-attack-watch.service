[Unit]
Description=MOHAAShield attack-watch (auto-freeze pcap ring on a traffic spike)
After=mohaashield-flightrecorder.service
Wants=mohaashield-flightrecorder.service

[Service]
Type=exec
ExecStart=/opt/mohaashield/attack-watch.sh
Restart=on-failure
RestartSec=5

# Unprivileged: only reads /sys stats and runs freeze.sh (copies pcap it owns).
User=mohaashield
Group=mohaashield
NoNewPrivileges=yes

# Sandboxing / hardening.
ProtectSystem=strict
ReadWritePaths=/var/lib/mohaashield/incidents
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

# Low priority only. NO hard MemoryMax: freeze.sh copies the ~2 GB ring, and that file
# page cache would trip a cgroup OOM (it did). The watcher's own RSS is a few MB and the
# copy's cache is reclaimable, so an explicit cap only causes OOM-kills.
Nice=10

[Install]
WantedBy=multi-user.target
