# MOHAAShield flight recorder + attack-watch config.
# Copy to /etc/mohaashield/flightrecorder.conf and set IFACE from Phase 0 recon.
# Keep comments on their OWN lines (values are used verbatim by the recorder).

# Public interface (see host/phase0/recon.sh output), e.g. ens3
IFACE=ens3

# Game UDP ports to record (space-separated). OpenMoHAA here uses 12203 and 12300.
PORTS="12203 12300"

# Bytes/packet captured: enough for IP+UDP + MOHAA OOB command + seq/qport
SNAPLEN=128

# Where ring files are written
OUTDIR=/var/lib/mohaashield/pcap

# Bounded ring buffer. Total on-disk cap = RING_FILESIZE_KB * RING_FILES.
# 32768 KB/file * 64 files = ~2 GB.
RING_FILESIZE_KB=32768
RING_FILES=64

# A freeze copies only the newest FREEZE_FILES ring files (not the whole ring) at idle I/O
# priority, so it can't stall the game. 8 * 32 MB = ~256 MB per freeze.
FREEZE_FILES=8
# Preserved (frozen) windows to keep. Total incidents disk = up to
# MAX_INCIDENTS * FREEZE_FILES * RING_FILESIZE_KB. 5 * 8 * 32 MB = ~1.3 GB.
MAX_INCIDENTS=5

# --- attack-watch (auto-freeze) ---
# Sensitive on purpose: a false CAPTURE trigger is fine, it only preserves pcap.
# Edge-triggered: freezes ONCE per attack, re-arms after calm, no re-freeze storm.
WATCH_INTERVAL=2
# Interface RX packets/sec above this = "attack" (normal peak here is ~1000-4000 pps).
WATCH_PPS_TRIGGER=4000
# Any NIC drop increase (rx_dropped/missed/fifo) over a sample also triggers.
WATCH_DROP_TRIGGER=1
# Re-arm only after traffic has been below the trigger this many seconds (attack ended).
WATCH_REARM_QUIET=60
# Re-snapshot a still-ongoing attack at most this often (seconds).
WATCH_MAX_HOLD=1800
